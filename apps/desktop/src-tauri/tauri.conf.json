{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC MAX",
  "version": "0.4.0",
  "identifier": "com.pcmax.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PC MAX",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://localhost:4000 http://127.0.0.1:4000 https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Premium PC gaming optimization",
    "longDescription": "PC MAX recommends and installs the optimal graphics and performance settings for your games, delivered live from the server.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCQzc2OTkwN0Q2NkY0MkQKUldRdDlHWjlrR25IaTdoQmhFam4vanhVODF3aGNRQm5TM1Z2MG5rODJXYUhUbGhXb0FGMklCRloK",
      "endpoints": [
        "https://pcmax-api.rixy.ir/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
