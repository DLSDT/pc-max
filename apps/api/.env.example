# ============================================================
# Game Optimization Hub — API environment
# Copy to .env and adjust for your machine.
# NEVER commit real secrets. Values here are dev defaults.
# ============================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://goh:goh@localhost:5432/goh

# Auth — MUST be replaced with long random values in production
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-production
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Comma-separated list of allowed browser origins (admin panel + tauri webview)
CORS_ORIGINS=http://localhost:3001,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Storage — "local" writes uploads to disk (dev), "s3" uses S3/R2
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Public base URL used to build image URLs for local storage
PUBLIC_API_URL=http://localhost:4000

# S3 / Cloudflare R2 (only when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Bootstrap admin (created by db:seed if no admin exists)
ADMIN_BOOTSTRAP_EMAIL=admin@gamehub.local
ADMIN_BOOTSTRAP_PASSWORD=Admin123!

# Global rate limit (requests per minute per IP)
RATE_LIMIT_MAX=300
