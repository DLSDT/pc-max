# ─── Game Optimization Hub — API environment ────────────────────────────────
# Copy to .env (or export in the environment) and adjust per deployment.
# The dev bootstrap (scripts/dev-embedded.ts) sets its own defaults — this file
# documents the production surface. All values are validated by config.ts at
# boot; invalid config fails fast.

# Runtime
NODE_ENV=development            # development | test | production
HOST=0.0.0.0
PORT=4000

# Database (PostgreSQL 16+)
DATABASE_URL=postgres://goh:goh@localhost:5432/goh

# Auth — NEVER ship the dev defaults in production (boot fails if you do).
JWT_ACCESS_SECRET=change-me-at-least-16-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# CORS (comma-separated). Desktop dev server, admin panel, Tauri origins.
CORS_ORIGINS=http://localhost:3001,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Storage — local (dev) or s3/R2 (production, private bucket).
STORAGE_DRIVER=local            # local | s3
UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:4000

# S3 / Cloudflare R2 (required when STORAGE_DRIVER=s3)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Secure downloads — package files are never public. The local driver issues
# HMAC-signed URLs validated by the API; S3 issues presigned GETs.
DOWNLOAD_SIGNING_SECRET=change-me-at-least-16-chars   # boot fails on the dev default in production
DOWNLOAD_URL_TTL=900           # seconds a signed download link stays valid (min 60)

# Bootstrap admin (created only if the admins table has no matching row)
ADMIN_BOOTSTRAP_EMAIL=admin@gamehub.local
ADMIN_BOOTSTRAP_PASSWORD=Admin123!   # change after first login

# Payments — provider-agnostic. mock auto-verifies (dev/tests).
PAYMENT_PROVIDER=mock          # mock | zarinpal
ZARINPAL_MERCHANT_ID=sandbox-test-merchant
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_BASE_URL=http://localhost:4000

# Auth hardening
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
RESET_TOKEN_EXPOSE=true        # false in production (reset tokens emailed, never returned)

# Rate limiting (per minute)
RATE_LIMIT_MAX=300              # global per-IP bound
RATE_LIMIT_VIEWS=120            # per-IP bound for the anonymous /views analytics endpoint

# Monitoring (Phase 18) — optional Sentry. Everything is redacted before it
# leaves the process (secrets stripped, emails masked, query strings dropped).
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENV=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
