{
  "name": "@goh/api",
  "version": "0.1.0",
  "private": true,
  "description": "Game Optimization Hub REST API (Fastify + Drizzle + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:seed": "tsx src/db/seed.ts",
    "catalog:import": "tsx src/scripts/import-catalog.ts",
    "dev:embedded": "tsx scripts/dev-embedded.ts",
    "db:backup": "tsx src/scripts/backup-db.ts",
    "db:restore": "tsx src/scripts/restore-db.ts",
    "db:retention": "tsx src/scripts/run-retention.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.3",
    "@fastify/swagger": "9.6.1",
    "@fastify/swagger-ui": "^5.2.0",
    "@goh/validation": "^0.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^10.70.0",
    "@types/nodemailer": "^8.0.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^18.19.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
