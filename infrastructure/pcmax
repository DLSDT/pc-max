#!/usr/bin/env bash
# PC MAX — one command for the whole stack.
#
# The deployment needs two compose files (the base plus the host-network
# override), which is easy to forget and silently gives you the wrong topology.
# This wraps them so day-to-day operation is `pcmax up`, `pcmax logs`, etc.
set -euo pipefail

# readlink -f resolves the symlink: this is installed as /usr/local/bin/pcmax,
# and without it DIR becomes /usr/local/bin, where the compose files are not.
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
COMPOSE=(docker compose -f "$DIR/docker-compose.yml" -f "$DIR/docker-compose.hostnet.yml")

case "${1:-help}" in
  up)       "${COMPOSE[@]}" up -d "${@:2}" ;;
  down)     "${COMPOSE[@]}" down "${@:2}" ;;
  restart)  "${COMPOSE[@]}" restart "${@:2}" ;;
  ps)       "${COMPOSE[@]}" ps ;;
  logs)     "${COMPOSE[@]}" logs --tail="${2:-60}" api ;;

  # Rebuild from the current checkout. Uses `docker build` directly because
  # compose refuses a host-network build without an extra privilege flag.
  deploy)
    cd "$DIR/.."
    git pull
    docker build --network=host -f apps/api/Dockerfile -t infrastructure-api:latest .
    "${COMPOSE[@]}" up -d --force-recreate api
    sleep 8
    curl -fsS localhost:4000/api/v1/health && echo " ✅ deployed"
    ;;

  backup)
    OUT="${2:-/www/pcmax-backups/db-$(date +%F-%H%M).json}"
    mkdir -p "$(dirname "$OUT")"
    "${COMPOSE[@]}" exec -T api node apps/api/dist/scripts/backup-db.js /tmp/b.json
    docker cp goh-api:/tmp/b.json "$OUT"
    echo "✅ $OUT"
    ;;

  restore)
    [ -n "${2:-}" ] || { echo "usage: pcmax restore <file.json>"; exit 1; }
    docker cp "$2" goh-api:/tmp/r.json
    "${COMPOSE[@]}" exec -T api node apps/api/dist/scripts/restore-db.js /tmp/r.json --force
    ;;

  # Re-point serial id sequences at their table's max. A restore inserts rows
  # with their original ids without advancing the sequences, so the next
  # ordinary insert fails on the primary key — this repairs that. Idempotent.
  fix-sequences)
    "${COMPOSE[@]}" exec -T api node apps/api/dist/scripts/fix-sequences.js
    ;;

  # Re-apply the curated genre/featured metadata after a deploy that changed
  # it. Idempotent, so running it on every deploy is harmless.
  metadata)
    "${COMPOSE[@]}" exec -T api node apps/api/dist/scripts/apply-catalog-metadata.js "${@:2}"
    ;;

  # Fill optimization_profiles.target_fps from each profile's preset colour.
  # Profiles ship with it NULL, which the app renders as "—". Idempotent: fills
  # NULLs only, so a target an admin set by hand survives. Pass --dry-run to
  # see the count first, --force to overwrite hand-set values.
  target-fps)
    "${COMPOSE[@]}" exec -T api node apps/api/dist/scripts/apply-target-fps.js "${@:2}"
    ;;

  # Create or rotate a super-admin login. Prompts for the password rather than
  # taking it as an argument, so it never lands in shell history.
  set-admin)
    [ -n "${2:-}" ] || { echo "usage: pcmax set-admin <email>"; exit 1; }
    read -rsp "New password for $2: " PW; echo
    [ -n "$PW" ] || { echo "aborted: empty password"; exit 1; }
    printf '%s' "$PW" | "${COMPOSE[@]}" exec -T api node apps/api/dist/scripts/set-admin-credentials.js "$2" --password-stdin
    unset PW
    ;;

  # Everything needed to rebuild this deployment somewhere else, in one file.
  #
  # `backup` alone is the database. Restoring only that onto a fresh box gives
  # you an API that starts, users who can sign in, and not one downloadable
  # file: the package payloads live in a docker volume nothing was copying, and
  # every package row would point at a storage key that no longer exists.
  # The secrets matter just as much — lose DOWNLOAD_SIGNING_SECRET and
  # JWT_ACCESS_SECRET and every issued link and session dies with them.
  backup-all)
    OUT_DIR="${2:-/www/pcmax-backups}"
    STAMP="$(date +%F-%H%M)"
    STAGE="$(mktemp -d)"
    trap 'rm -rf "$STAGE"' EXIT
    mkdir -p "$OUT_DIR"

    echo "→ database"
    "${COMPOSE[@]}" exec -T api node apps/api/dist/scripts/backup-db.js /tmp/b.json >/dev/null
    docker cp goh-api:/tmp/b.json "$STAGE/db.json"

    # The volume is named by compose, which prefixes it with the project name.
    # Finding it beats hardcoding a name that changes with the directory.
    echo "→ uploaded package files"
    VOL="$(docker volume ls -q | grep -E 'uploads$' | head -1)"
    [ -n "$VOL" ] || { echo "could not find the uploads volume; is the stack up?"; exit 1; }
    docker run --rm -v "$VOL":/data:ro -v "$STAGE":/out alpine \
      tar czf /out/uploads.tgz -C /data .

    echo "→ secrets and compose env"
    cp "$DIR/.env" "$STAGE/env" 2>/dev/null || echo "(no infrastructure/.env found)"

    ARCHIVE="$OUT_DIR/pcmax-full-$STAMP.tar.gz"
    tar czf "$ARCHIVE" -C "$STAGE" .

    # A backup nobody has opened is a guess. Each of these has a way of going
    # quietly wrong: the volume lookup could match an empty volume, the db dump
    # could be a truncated file that still exists, and the .env copy is allowed
    # to fail so a machine without one can still be backed up — which is fine
    # until it is the machine that had one.
    echo "→ verifying"
    FILES="$(tar tzf "$STAGE/uploads.tgz" | grep -c . || true)"
    DB_ROWS="$(python3 -c "import json,sys;d=json.load(open(sys.argv[1]));print(sum(len(v) for v in d.values() if isinstance(v,list)))" "$STAGE/db.json" 2>/dev/null || echo 0)"
    [ "$FILES" -gt 0 ]   || { echo "❌ the uploads archive is empty — refusing to call this a backup"; exit 1; }
    [ "$DB_ROWS" -gt 0 ] || { echo "❌ the database dump has no rows — refusing to call this a backup"; exit 1; }
    [ -s "$STAGE/env" ]  || echo "⚠️  no .env captured: a restore would need the secrets from somewhere else"

    echo
    echo "✅ $ARCHIVE  ($(du -h "$ARCHIVE" | cut -f1))"
    echo "   $FILES uploaded files, $DB_ROWS database rows"
    echo
    echo "This is still on the machine it protects. Copy it off:"
    echo "    scp root@<this-server>:$ARCHIVE ."
    ;;

  health)
    echo -n "local:  "; curl -fsS localhost:4000/api/v1/health || echo "DOWN"
    echo -n "public: "; curl -fsS https://pc-maxapp.rixy.ir/api/v1/health || echo "DOWN"
    ;;

  *) echo "usage: pcmax {up|down|restart|ps|logs|deploy|metadata|target-fps|set-admin <email>|fix-sequences|backup|backup-all [dir]|restore <f>|health}" ;;
esac
